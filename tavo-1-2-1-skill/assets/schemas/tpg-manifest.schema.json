{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tavo-skill/schemas/tpg-manifest.schema.json",
  "title": "Tavo Plugin Manifest 0.93",
  "description": "Schema for Tavo plugin manifest specs 1 and 2. Omitted specVersion means v1; root entry wins over the legacy scripts.actions alias.",
  "type": "object",
  "required": ["id", "name", "version"],
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))\\S(?:.*\\S)?$",
      "description": "Package-relative virtual path using forward slashes; absolute paths, URLs, backslashes, redundant segments, and traversal are forbidden."
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-([0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*|0|[1-9][0-9]*)(\\.([0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*|0|[1-9][0-9]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "localeTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
      "description": "Hyphenated locale tag such as en, en-US, zh-Hans, or zh-CN."
    },
    "translationRef": {
      "type": "object",
      "required": ["$t"],
      "properties": {
        "$t": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "localizedLabel": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/translationRef" }
      ]
    },
    "localizedText": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/translationRef" }
      ]
    },
    "localization": {
      "type": "object",
      "required": ["defaultLocale"],
      "properties": {
        "defaultLocale": { "$ref": "#/$defs/localeTag" },
        "resources": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/localeTag" },
          "additionalProperties": { "$ref": "#/$defs/packagePath" }
        }
      },
      "additionalProperties": false
    },
    "fragment": {
      "type": "object",
      "required": ["src"],
      "properties": {
        "src": { "$ref": "#/$defs/packagePath" }
      },
      "additionalProperties": true
    },
    "v1Action": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/packagePath" }
      },
      "additionalProperties": true
    },
    "v2Action": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/localizedLabel" },
        "icon": { "$ref": "#/$defs/packagePath" }
      },
      "additionalProperties": true
    },
    "v2SelectOption": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/localizedLabel" }
      },
      "additionalProperties": false
    },
    "v1Setting": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "key", "label"],
          "properties": {
            "type": { "const": "switch" },
            "key": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "default": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["type", "key", "label", "options"],
          "properties": {
            "type": { "const": "select" },
            "key": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "default": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "key", "label", "min", "max"],
          "properties": {
            "type": { "const": "slider" },
            "key": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "default": { "type": "number" }
          }
        },
        {
          "type": "object",
          "required": ["type", "key", "label"],
          "properties": {
            "type": { "enum": ["text", "textarea"] },
            "key": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "default": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "info" },
            "text": { "type": "string", "minLength": 1 },
            "icon": { "enum": ["info", "warning"] }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["divider", "break"] }
          }
        }
      ]
    },
    "v2Setting": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "key", "label"],
          "properties": {
            "type": { "const": "switch" },
            "key": { "type": "string", "minLength": 1 },
            "label": { "$ref": "#/$defs/localizedLabel" },
            "default": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["type", "key", "label", "options"],
          "properties": {
            "type": { "const": "select" },
            "key": { "type": "string", "minLength": 1 },
            "label": { "$ref": "#/$defs/localizedLabel" },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  { "$ref": "#/$defs/v2SelectOption" }
                ]
              }
            },
            "default": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "key", "label", "min", "max"],
          "properties": {
            "type": { "const": "slider" },
            "key": { "type": "string", "minLength": 1 },
            "label": { "$ref": "#/$defs/localizedLabel" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "default": { "type": "number" }
          }
        },
        {
          "type": "object",
          "required": ["type", "key", "label"],
          "properties": {
            "type": { "enum": ["text", "textarea"] },
            "key": { "type": "string", "minLength": 1 },
            "label": { "$ref": "#/$defs/localizedLabel" },
            "default": { "$ref": "#/$defs/localizedText" }
          }
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "info" },
            "text": { "$ref": "#/$defs/localizedLabel" },
            "icon": { "enum": ["info", "warning"] }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["divider", "break"] }
          }
        }
      ]
    },
    "v1Contributes": {
      "type": "object",
      "properties": {
        "inputActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/v1Action" }
        },
        "sidebar": {
          "type": "array",
          "items": { "$ref": "#/$defs/v1Action" }
        },
        "htmlFragments": {
          "type": "array",
          "items": { "$ref": "#/$defs/fragment" }
        },
        "settings": {
          "type": "object",
          "required": ["schema"],
          "properties": {
            "schema": {
              "type": "array",
              "items": { "$ref": "#/$defs/v1Setting" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "v2Contributes": {
      "type": "object",
      "properties": {
        "inputActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/v2Action" }
        },
        "sidebar": {
          "type": "array",
          "items": { "$ref": "#/$defs/v2Action" }
        },
        "htmlFragments": {
          "type": "array",
          "items": { "$ref": "#/$defs/fragment" }
        },
        "settings": {
          "type": "object",
          "required": ["schema"],
          "properties": {
            "schema": {
              "type": "array",
              "items": { "$ref": "#/$defs/v2Setting" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "specVersion": { "type": "integer", "enum": [1, 2] },
    "entry": {
      "$ref": "#/$defs/packagePath",
      "description": "Preferred plugin runtime entry. When both declarations exist, this field wins."
    },
    "cover": { "$ref": "#/$defs/packagePath" },
    "scripts": {
      "type": "object",
      "properties": {
        "actions": {
          "$ref": "#/$defs/packagePath",
          "deprecated": true,
          "description": "Legacy compatibility alias used only when root entry is absent."
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["specVersion"],
        "properties": { "specVersion": { "const": 2 } }
      },
      "then": {
        "required": ["localization"],
        "properties": {
          "name": { "$ref": "#/$defs/localizedLabel" },
          "description": { "$ref": "#/$defs/localizedText" },
          "version": { "$ref": "#/$defs/semver" },
          "minAppVersion": { "$ref": "#/$defs/semver" },
          "localization": { "$ref": "#/$defs/localization" },
          "contributes": { "$ref": "#/$defs/v2Contributes" }
        }
      },
      "else": {
        "not": { "required": ["localization"] },
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "version": { "type": "string", "minLength": 1 },
          "minAppVersion": { "type": "string", "minLength": 1 },
          "contributes": { "$ref": "#/$defs/v1Contributes" }
        }
      }
    },
    {
      "if": {
        "required": ["contributes"],
        "properties": {
          "contributes": {
            "anyOf": [
              {
                "required": ["inputActions"],
                "properties": { "inputActions": { "type": "array", "minItems": 1 } }
              },
              {
                "required": ["sidebar"],
                "properties": { "sidebar": { "type": "array", "minItems": 1 } }
              }
            ]
          }
        }
      },
      "then": {
        "anyOf": [
          { "required": ["entry"] },
          {
            "required": ["scripts"],
            "properties": {
              "scripts": {
                "type": "object",
                "required": ["actions"]
              }
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": true
}
