    "entries": [
      {
        "identifier": "session-main",
        "name": "Session main",
        "content": "<% incvar(\"prompt_lab.turn\") %>[PROMPT_LAB_TURN]=<%- getvar(\"prompt_lab.turn\") %>\nWrite the next reply as {{char}} and preserve continuity with the visible conversation history.",
