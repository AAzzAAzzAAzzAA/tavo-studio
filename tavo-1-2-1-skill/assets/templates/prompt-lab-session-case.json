        "type": "custom",
        "injectionPosition": "relative",
        "injectionDepth": 0,
        "forbidOverrides": true,
        "enabled": true,
        "active": true
      },
      {
        "identifier": "personaDescription",
        "name": "Persona Description",
        "content": "",
        "role": "system",
        "type": "marker",
        "injectionPosition": "relative",
        "injectionDepth": 4,
        "enabled": true,
        "active": true
      },
      {
        "identifier": "charDescription",
        "name": "Character Description",
        "content": "",
        "role": "system",
        "type": "marker",
        "injectionPosition": "relative",
        "injectionDepth": 4,
        "enabled": true,
        "active": true
      },
      {
        "identifier": "scenario",
        "name": "Scenario",
        "content": "",
        "role": "system",
        "type": "marker",
        "injectionPosition": "relative",
        "injectionDepth": 4,
        "enabled": true,
        "active": true
      },
      {
        "identifier": "worldInfoAfter",
        "name": "Lorebook After",
        "content": "",
        "role": "system",
